<?xml version="1.0"?>
<sdf version="1.7">
  <model name="pai_color_marker">
    <static>true</static>
    <!-- 搬送する箱とは別に、作業領域の近くに置く色標識。 -->
    <pose>0.38 -0.30 1.20 0 0 0</pose>
    <link name="link">
      <visual name="color_patch">
        <geometry><box><size>0.22 0.22 0.004</size></box></geometry>
        <material>
          <ambient>0.05 0.13 0.98 1</ambient>
          <diffuse>0.05 0.13 0.98 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <!-- 箱やグリッパーに干渉しないよう、衝突形状は設定しない。 -->
    </link>
  </model>
</sdf>

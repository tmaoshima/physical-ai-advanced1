<?xml version="1.0"?>
<sdf version="1.7">
  <model name="pai_overhead_camera">
    <static>true</static>
    <!-- ワールド座標で下向きに配置する。正のピッチ回転で+Xを-Zへ向ける。 -->
    <pose>0.38 -0.30 1.85 0 1.57079632679 0</pose>
    <link name="camera_link">
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="pai_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>3</update_rate>
        <topic>/pai/camera/image</topic>
        <camera>
          <horizontal_fov>0.9</horizontal_fov>
          <image><width>320</width><height>240</height><format>R8G8B8</format></image>
          <clip><near>0.03</near><far>8</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
